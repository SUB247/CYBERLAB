# ==============================================================================
# CYBERLAB ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and add your Supabase project credentials.
# ==============================================================================

# Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public API Key (safe for browser usage with Row Level Security)
# CYBERLAB supports BOTH formats:
# 1. Modern Publishable Key format: sb_publishable_...
# 2. Legacy Anon JWT Key format: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# NOTE: Never expose your service_role / secret key (sb_secret_*) in client environment variables!
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
